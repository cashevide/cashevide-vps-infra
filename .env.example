# Cloudflare R2 credentials for automated database backups
# Copy this file to .env and fill in real values — .env is gitignored

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=cashevide-backups
R2_ENDPOINT=https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com

# Local backup retention (days) — older files auto-deleted
BACKUP_RETENTION_DAYS=30
